{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Relay's main window and floating popup",
  "windows": [
    "main",
    "popup"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "opener:default",
    "dialog:default",
    "autostart:default",
    "core:window:allow-start-dragging"
  ]
}
