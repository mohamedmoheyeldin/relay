{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay Rust",
  "version": "0.2.0",
  "identifier": "dev.relay.operator",
  "build": {
    "frontendDist": "../crates/relay-ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../crates/relay-ui", "wait": false },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../crates/relay-ui", "wait": true }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Relay",
        "width": 480,
        "height": 740,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "AI desktop operator",
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp"
      }
    }
  }
}
