{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay",
  "version": "0.2.0",
  "identifier": "dev.relay.operator",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../ui", "wait": false },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../ui", "wait": true }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Relay",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#212121"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "AI desktop operator"
  }
}
