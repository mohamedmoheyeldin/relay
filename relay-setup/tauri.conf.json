{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay Setup",
  "mainBinaryName": "relay-setup",
  "identifier": "com.relay.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Relay Setup",
        "width": 560,
        "height": 420,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../relay-ui/src-tauri/icons/icon.ico", "../relay-ui/src-tauri/icons/128x128.png"]
  }
}
